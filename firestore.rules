rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'disabled';
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeamLead() {
      return activeUser() && callerRole() == 'team_lead';
    }

    function canReview() {
      return activeUser() && callerRole() in ['team_lead', 'quality_supervisor'];
    }

    function ownsExistingAgentRecord() {
      return activeUser() && resource.data.agentId == request.auth.uid;
    }

    function ownsIncomingAgentRecord() {
      return activeUser() && request.resource.data.agentId == request.auth.uid;
    }

    function ownsExistingTicket() {
      return activeUser() && resource.data.createdById == request.auth.uid;
    }

    function ownsIncomingTicket() {
      return activeUser() && request.resource.data.createdById == request.auth.uid;
    }

    function hasOneTimeTicketEdit() {
      return ownsExistingTicket()
        && resource.data.editApprovedForId == request.auth.uid
        && resource.data.editApprovalUsed != true
        && request.resource.data.editApprovalUsed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'customerName',
          'customerPhone',
          'accountNumber',
          'department',
          'priority',
          'status',
          'description',
          'nextAction',
          'lastEditedById',
          'lastEditedByName',
          'editApprovalUsed',
          'updatedAt'
        ]);
    }

    function ownsIncomingTicketEditRequest() {
      return activeUser()
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.status == 'pending';
    }

    function canMarkOwnEditRequestUsed() {
      return activeUser()
        && resource.data.agentId == request.auth.uid
        && resource.data.status == 'approved'
        && request.resource.data.status == 'used'
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'used', 'usedAt', 'updatedAt']);
    }

    match /banned_phrases/{document} {
      allow read: if activeUser();
      allow write: if canReview();
    }

    match /flags/{document} {
      allow create: if canReview() || ownsIncomingAgentRecord();
      allow read: if canReview() || ownsExistingAgentRecord();
      allow update: if canReview();
      allow delete: if canReview();
    }

    match /agent_actions/{document} {
      allow create: if ownsIncomingAgentRecord();
      allow read: if canReview() || ownsExistingAgentRecord();
      allow update: if canReview();
    }

    match /tickets/{document} {
      allow create: if ownsIncomingTicket();
      allow read: if canReview() || ownsExistingTicket();
      allow update: if canReview() || hasOneTimeTicketEdit();
    }

    match /ticket_edit_requests/{document} {
      allow create: if ownsIncomingTicketEditRequest();
      allow read: if canReview() || resource.data.agentId == request.auth.uid;
      allow update: if canReview() || canMarkOwnEditRequestUsed();
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || canReview());
      allow update: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mustChangePassword', 'passwordChangedAt', 'updatedAt']);
      allow write: if isTeamLead();
    }

    match /knowledge_base/{document} {
      allow read: if signedIn();
      allow write: if canReview();
    }

    match /action_types/{document} {
      allow read: if signedIn();
      allow write: if canReview();
    }

    match /agents_coaching_notes/{agentId} {
      allow read, write: if canReview();
    }

    match /after_call_reports/{document} {
      allow create: if ownsIncomingAgentRecord();
      allow read: if canReview() || ownsExistingAgentRecord();
      allow update: if canReview();
    }
  }
}
