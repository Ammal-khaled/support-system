{
  "manifest_version": 3,
  "name": "CSR Support System",
  "version": "1.0.0",
  "description": "Chrome extension companion for the CSR Support System dashboard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://firestore.googleapis.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*", "https://aquadesk-ai.aquadesk-support.workers.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.mq.maqsam.com/*", "http://localhost:3000/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CSR Support System"
  }
}
